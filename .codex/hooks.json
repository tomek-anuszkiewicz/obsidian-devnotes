{
  "description": "Codex lifecycle hooks for this vault.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/check_polish.py\"",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)\\.codex\\hooks\\check_polish.py\"",
            "timeout": 15,
            "statusMessage": "Checking public note edits for Polish text"
          }
        ]
      }
    ]
  }
}
